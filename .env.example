# Faizan Sheikh — Portfolio env vars
# Copy this file to .env.local and fill in what you need.
# Nothing below is required for the site to build or deploy — the contact
# form gracefully falls back to a mailto: link if these are missing.

# --- Contact form transport (optional) ---
# Get a key from https://resend.com. Any Resend-verified sender works.
# When present, POST /api/contact sends via Resend; when absent, the
# route returns 501 and the client opens a prefilled mailto: instead.
RESEND_API_KEY=

# From address the form sends *from*. Must be verified in your Resend
# account. Defaults to "portfolio@resend.dev" if unset (works with the
# Resend sandbox domain during initial setup).
CONTACT_FROM_EMAIL=portfolio@resend.dev

# Inbox address the form sends *to*. Defaults to the address in
# lib/data.ts if unset.
CONTACT_TO_EMAIL=

# --- Site URL (recommended for production) ---
# Used for OpenGraph, canonical URLs, sitemap.xml, robots.txt, and
# JSON-LD. Set this to whatever the live site is served from.
# Falls back to https://faizansheikh.dev in lib/constants.ts if unset.
NEXT_PUBLIC_SITE_URL=

# --- Vercel Analytics (optional) ---
# The @vercel/analytics package can be added later; no key needed on
# Vercel — this stub is here for parity with other setups.
# ANALYTICS_ID=
